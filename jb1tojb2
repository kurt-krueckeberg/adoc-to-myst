#!/usr/bin/env bash
set -euo pipefail

# Wrapper for jb1_to_jb2_myst.py: copy a JB1 book to a new directory,
# converted for JB2, then migrate its config with `jupyter-book init`.
#
#   jb1tojb2 SOURCE_DIR DEST_DIR
#   jb1tojb2 SOURCE.md DEST.md

CONVERTER="${JB1_TO_JB2_CONVERTER:-$HOME/adoc-to-myst/jb1_to_jb2_myst.py}"

usage() {
  cat <<'EOF'
Usage:
  jb1tojb2 SOURCE_DIR DEST_DIR
  jb1tojb2 SOURCE.md DEST.md

Examples:
  jb1tojb2 ~/sphinx-nla ~/jupyter-nla
  jb1tojb2 ~/sphinx-nla/1237/example.md ~/jupyter-nla/1237/example.md

SOURCE_DIR is copied to DEST_DIR (which must not be inside it), converting
the .md files for JB2 and copying everything else. Then `jupyter-book init`
migrates _config.yml/_toc.yml to myst.yml in DEST_DIR. The JB1 book is not
modified. A report lists anything that JB2 or its PDF output would drop.

Set JB1_TO_JB2_CONVERTER=/path/to/jb1_to_jb2_myst.py to override the converter path.
EOF
}

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -ne 2 ]]; then
  echo "Error: expected exactly two arguments: SOURCE DEST" >&2
  echo >&2
  usage >&2
  exit 1
fi

if [[ ! -f "$CONVERTER" ]]; then
  echo "Error: converter script not found: $CONVERTER" >&2
  exit 1
fi

SRC="$1"
DST="$2"

if [[ ! -e "$SRC" ]]; then
  echo "Error: source is not a file or directory: $SRC" >&2
  exit 1
fi

python3 "$CONVERTER" "$SRC" "$DST"

if [[ -d "$SRC" && -f "$DST/_config.yml" && ! -f "$DST/myst.yml" ]]; then
  # init asks for confirmation; `|| true` stops yes's SIGPIPE tripping pipefail.
  (cd "$DST" && { yes || true; } | jupyter-book init --write-toc)
fi
